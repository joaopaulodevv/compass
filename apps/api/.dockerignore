# Build context for the API image. Only pyproject.toml, uv.lock, alembic.ini,
# README.md and src/ are needed; everything else is excluded so the context stays
# small and no local environment leaks into the image.
.venv
__pycache__
**/__pycache__
**/*.py[cod]
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
coverage.xml
htmlcov
tests
.env
.env.*
