# Copy to `.env` and adjust. Never commit a populated `.env`.
#
# Only APP_ENV / DATABASE_URL / REDIS_URL matter in the current phase. Everything under
# "future capabilities" is documented ahead of time and is optional: a missing value
# must not prevent the application from starting.

# --- Application -------------------------------------------------------------------
# local | test | staging | production
APP_ENV=local
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- PostgreSQL --------------------------------------------------------------------
# Credentials used by the `postgres` service in docker-compose.yml.
POSTGRES_USER=compass
POSTGRES_PASSWORD=compass
POSTGRES_DB=compass

# Connection string used by the API and by Alembic.
# Host `localhost` when running the API on your machine; host `postgres` inside Compose.
DATABASE_URL=postgresql+asyncpg://compass:compass@localhost:5432/compass
# Set to true to log every SQL statement (noisy; development only).
DATABASE_ECHO=false

# --- Redis -------------------------------------------------------------------------
# Provisioned for future use (caching, background jobs, rate limiting). Nothing in the
# application consumes it yet - see docs/architecture.md.
# Host `localhost` when running locally; host `redis` inside Compose.
REDIS_URL=redis://localhost:6379/0

# --- Assistant ---------------------------------------------------------------------
# The conversational endpoints need this. Without it they answer 503 and the rest of the
# API is unaffected. Never commit a real key.
OPENAI_API_KEY=
# Which model the assistant uses.
OPENAI_MODEL=gpt-4o-mini

# --- Future capabilities (not implemented yet) -------------------------------------
# Vector store for the future RAG knowledge base.
PINECONE_API_KEY=
# LLM/agent observability.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Application/infrastructure observability.
DATADOG_API_KEY=

# --- Open Finance ------------------------------------------------------------------
# No provider has been chosen yet and no integration exists. Real financial
# credentials must never be committed; sandbox and production credentials must stay
# in separate environments.
